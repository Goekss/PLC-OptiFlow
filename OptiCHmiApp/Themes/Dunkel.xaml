<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Neutrale Industrieflächen, Farbe nur für Zustände (ISA-101) -->
    <SolidColorBrush x:Key="Hintergrund" Color="#0D0F14"/>
    <SolidColorBrush x:Key="Seitenleiste" Color="#12151C"/>
    <SolidColorBrush x:Key="Karte" Color="#161A22"/>
    <SolidColorBrush x:Key="KarteRand" Color="#252B38"/>
    <SolidColorBrush x:Key="Akzent" Color="#3E8BFF"/>
    <SolidColorBrush x:Key="AkzentKontrast" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AkzentSoft" Color="#1C3E8BFF"/>
    <SolidColorBrush x:Key="TextPrimaer" Color="#E7EAF1"/>
    <SolidColorBrush x:Key="TextSekundaer" Color="#8A92A6"/>
    <SolidColorBrush x:Key="Trennlinie" Color="#262D3B"/>
    <SolidColorBrush x:Key="Zelle" Color="#0F131A"/>
    <SolidColorBrush x:Key="MenuHover" Color="#143E8BFF"/>
    <SolidColorBrush x:Key="MenuAuswahl" Color="#223E8BFF"/>
    <SolidColorBrush x:Key="Erfolg" Color="#22C55E"/>
    <SolidColorBrush x:Key="Warnung" Color="#E8A33D"/>
    <SolidColorBrush x:Key="Gefahr" Color="#E5484D"/>
    <SolidColorBrush x:Key="GefahrFlaeche" Color="#8E1D22"/>
    <SolidColorBrush x:Key="Info" Color="#3E8BFF"/>
    <SolidColorBrush x:Key="SchalterAus" Color="#394255"/>
    <SolidColorBrush x:Key="SchalterDaumen" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextInvertiert" Color="#FFFFFF"/>

    <!-- Skala des Rundinstruments: neutral bis 80 °C, dann Warn- und Kritischzone -->
    <LinearGradientBrush x:Key="SkalaVerlauf" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#394255" Offset="0"/>
        <GradientStop Color="#394255" Offset="0.8"/>
        <GradientStop Color="#E8A33D" Offset="0.8"/>
        <GradientStop Color="#E8A33D" Offset="0.9"/>
        <GradientStop Color="#E5484D" Offset="0.9"/>
        <GradientStop Color="#E5484D" Offset="1"/>
    </LinearGradientBrush>

    <RadialGradientBrush x:Key="NadelZentrum" Center="0.5,0.5" GradientOrigin="0.5,0.5"
                         RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="#FFFFFF" Offset="0"/>
        <GradientStop Color="#394255" Offset="1"/>
    </RadialGradientBrush>

    <DropShadowEffect x:Key="AkzentGlow" Color="#3E8BFF" BlurRadius="12" ShadowDepth="0" Opacity="0.6"/>
    <DropShadowEffect x:Key="AkzentGlowSanft" Color="#3E8BFF" BlurRadius="8" ShadowDepth="0" Opacity="0.3"/>
    <DropShadowEffect x:Key="AkzentGlowStark" Color="#3E8BFF" BlurRadius="12" ShadowDepth="0" Opacity="0.7"/>
    <DropShadowEffect x:Key="SchattenGlow" Color="#000000" BlurRadius="6" ShadowDepth="0" Opacity="0.3"/>
</ResourceDictionary>
