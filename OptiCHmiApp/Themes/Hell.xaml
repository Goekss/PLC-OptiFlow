<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Neutrale Industrieflächen, Farbe nur für Zustände (ISA-101) -->
    <SolidColorBrush x:Key="Hintergrund" Color="#EEF1F6"/>
    <SolidColorBrush x:Key="Seitenleiste" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Karte" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="KarteRand" Color="#D5DBE6"/>
    <SolidColorBrush x:Key="Akzent" Color="#1D4ED8"/>
    <SolidColorBrush x:Key="AkzentKontrast" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AkzentSoft" Color="#141D4ED8"/>
    <SolidColorBrush x:Key="TextPrimaer" Color="#101828"/>
    <SolidColorBrush x:Key="TextSekundaer" Color="#5B6675"/>
    <SolidColorBrush x:Key="Trennlinie" Color="#D5DBE6"/>
    <SolidColorBrush x:Key="Zelle" Color="#F4F6FA"/>
    <SolidColorBrush x:Key="MenuHover" Color="#0F1D4ED8"/>
    <SolidColorBrush x:Key="MenuAuswahl" Color="#1A1D4ED8"/>
    <SolidColorBrush x:Key="Erfolg" Color="#15803D"/>
    <SolidColorBrush x:Key="Warnung" Color="#B45309"/>
    <SolidColorBrush x:Key="Gefahr" Color="#B91C1C"/>
    <SolidColorBrush x:Key="GefahrFlaeche" Color="#B91C1C"/>
    <SolidColorBrush x:Key="Info" Color="#1D4ED8"/>
    <SolidColorBrush x:Key="SchalterAus" Color="#C7CED9"/>
    <SolidColorBrush x:Key="SchalterDaumen" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextInvertiert" Color="#FFFFFF"/>

    <!-- Skala des Rundinstruments: neutral bis 80 °C, dann Warn- und Kritischzone -->
    <LinearGradientBrush x:Key="SkalaVerlauf" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#C7CED9" Offset="0"/>
        <GradientStop Color="#C7CED9" Offset="0.8"/>
        <GradientStop Color="#B45309" Offset="0.8"/>
        <GradientStop Color="#B45309" Offset="0.9"/>
        <GradientStop Color="#B91C1C" Offset="0.9"/>
        <GradientStop Color="#B91C1C" Offset="1"/>
    </LinearGradientBrush>

    <RadialGradientBrush x:Key="NadelZentrum" Center="0.5,0.5" GradientOrigin="0.5,0.5"
                         RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="#FFFFFF" Offset="0"/>
        <GradientStop Color="#C7CED9" Offset="1"/>
    </RadialGradientBrush>

    <DropShadowEffect x:Key="AkzentGlow" Color="#1D4ED8" BlurRadius="12" ShadowDepth="0" Opacity="0.25"/>
    <DropShadowEffect x:Key="AkzentGlowSanft" Color="#1D4ED8" BlurRadius="8" ShadowDepth="0" Opacity="0.15"/>
    <DropShadowEffect x:Key="AkzentGlowStark" Color="#1D4ED8" BlurRadius="12" ShadowDepth="0" Opacity="0.2"/>
    <DropShadowEffect x:Key="SchattenGlow" Color="#000000" BlurRadius="6" ShadowDepth="0" Opacity="0.3"/>
</ResourceDictionary>
