<UserControl x:Class="OptiCHmiApp.Views.EinstellungenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <!-- Verbindung -->
            <TextBlock Text="{DynamicResource VerbindungTitel}" Style="{StaticResource AbschnittTitelStil}"/>
            <Border Style="{StaticResource KarteStil}" Margin="0,10,0,16">
                <StackPanel>
                    <TextBlock Text="{DynamicResource BackendAdresse}" FontSize="13" Foreground="{DynamicResource TextSekundaer}"/>
                    <TextBox Style="{StaticResource TexteingabeStil}" Margin="0,8,0,0"
                             Text="{Binding BackendAdresse, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="{DynamicResource BackendAdresseHinweis}"
                               FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSekundaer}"/>
                    <TextBlock Text="{DynamicResource AbfrageIntervall}" FontSize="13" Margin="0,16,0,0"
                               Foreground="{DynamicResource TextSekundaer}"/>
                    <TextBox Style="{StaticResource TexteingabeStil}" Margin="0,8,0,0"
                             Text="{Binding AbfrageIntervallMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
            </Border>

            <!-- Darstellung -->
            <TextBlock Text="{DynamicResource DarstellungTitel}" Style="{StaticResource AbschnittTitelStil}"/>
            <Border Style="{StaticResource KarteStil}" Margin="0,10,0,16">
                <CheckBox Style="{StaticResource UmschalterStil}" IsChecked="{Binding IstDunkel, Mode=TwoWay}">
                    <TextBlock Text="{DynamicResource DunklesDesign}" FontSize="14" Foreground="{DynamicResource TextPrimaer}"/>
                </CheckBox>
            </Border>

            <!-- Sprache -->
            <TextBlock Text="{DynamicResource SpracheTitel}" Style="{StaticResource AbschnittTitelStil}"/>
            <Border Style="{StaticResource KarteStil}" Margin="0,10,0,16">
                <ItemsControl ItemsSource="{Binding Sprachen}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Name}" Margin="0,0,8,8" Padding="18,8" FontSize="13"
                                    Command="{Binding DataContext.SpracheWaehlenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SekundaerButtonStil}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IstAktiv}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource AkzentSoft}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource Akzent}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- Speichern -->
            <StackPanel Orientation="Horizontal">
                <Button Content="{DynamicResource Speichern}" Command="{Binding SpeichernCommand}"
                        Style="{StaticResource PrimaerButtonStil}"/>
                <TextBlock Text="{Binding SpeicherStatus}" Margin="14,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource Erfolg}" FontSize="13"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
