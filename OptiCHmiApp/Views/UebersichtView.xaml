<UserControl x:Class="OptiCHmiApp.Views.UebersichtView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:OptiCHmiApp.Views">

    <UserControl.Resources>
        <Style x:Key="AktionsButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Akzent}"/>
            <Setter Property="Foreground" Value="{DynamicResource AkzentKontrast}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="28,10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Laeuft}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Gefahr}"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="GitterLinie" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource Trennlinie}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>

        <Style x:Key="KennzahlStil" TargetType="Border" BasedOn="{StaticResource KarteStil}">
            <Setter Property="Padding" Value="16"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Üst kart: sıcaklık + kadran + kontroller -->
        <Border Grid.Row="0" Style="{StaticResource KarteStil}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="260"/>
                    <ColumnDefinition Width="*" MaxWidth="240"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="PLC TEMPERATUR" Style="{StaticResource AbschnittTitelStil}"/>
                        <Border CornerRadius="10" Padding="8,3" Margin="10,0,0,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource AkzentSoft}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IstSimulation}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource SchalterAus}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{DynamicResource Akzent}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IstSimulation}" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource Warnung}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock FontSize="10" FontWeight="SemiBold" Margin="5,0,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="LIVE"/>
                                            <Setter Property="Foreground" Value="{DynamicResource Akzent}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IstSimulation}" Value="True">
                                                    <Setter Property="Text" Value="SIMULATION"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource Warnung}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="{Binding Temperatur, StringFormat={}{0:F1}}"
                                   FontSize="54" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaer}"/>
                        <TextBlock Text="°C" FontSize="20" Margin="6,16,0,0"
                                   Foreground="{DynamicResource Akzent}"/>
                    </StackPanel>

                    <Rectangle Height="1" Fill="{DynamicResource Trennlinie}" Margin="0,16,0,16"/>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="{Binding StartStoppText}" Command="{Binding StartStoppCommand}"
                                Style="{StaticResource AktionsButton}"/>
                        <TextBlock Margin="20,0,0,0" VerticalAlignment="Center" FontSize="13"
                                   Foreground="{DynamicResource TextSekundaer}">
                            <Run Text="Letzte Antwort: "/>
                            <Run Text="{Binding LetzteAntwortMs, Mode=OneWay}"
                                 Foreground="{DynamicResource Akzent}" FontWeight="SemiBold"/>
                            <Run Text=" ms"/>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>

                <Viewbox Grid.Column="1" Stretch="Uniform" StretchDirection="DownOnly"
                         HorizontalAlignment="Right" VerticalAlignment="Center" Margin="20,0,0,0">
                    <views:Rundanzeige Wert="{Binding Temperatur}"/>
                </Viewbox>
            </Grid>
        </Border>

        <!-- Kennzahlen -->
        <UniformGrid x:Name="KpiGrid" Grid.Row="1" Margin="0,12,0,0" Columns="3">
            <Border Margin="4" Style="{StaticResource KennzahlStil}">
                <StackPanel>
                    <TextBlock Text="MINIMUM" FontSize="11" Foreground="{DynamicResource TextSekundaer}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="{Binding Minimum}" FontSize="26" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaer}"/>
                        <TextBlock Text="°C" FontSize="12" Foreground="{DynamicResource Akzent}"
                                   VerticalAlignment="Bottom" Margin="4,0,0,5"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Margin="4" Style="{StaticResource KennzahlStil}">
                <StackPanel>
                    <TextBlock Text="MAXIMUM" FontSize="11" Foreground="{DynamicResource TextSekundaer}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="{Binding Maximum}" FontSize="26" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaer}"/>
                        <TextBlock Text="°C" FontSize="12" Foreground="{DynamicResource Akzent}"
                                   VerticalAlignment="Bottom" Margin="4,0,0,5"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Margin="4" Style="{StaticResource KennzahlStil}">
                <StackPanel>
                    <TextBlock Text="MESSUNGEN" FontSize="11" Foreground="{DynamicResource TextSekundaer}"/>
                    <TextBlock Text="{Binding Messungen}" FontSize="26" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaer}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Alt kart: trend grafiği -->
        <Border Grid.Row="2" Style="{StaticResource KarteStil}" Margin="0,16,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="{DynamicResource Akzent}"
                                 Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="LIVE" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Akzent}"/>
                    </StackPanel>
                    <TextBlock Text="TEMPERATURVERLAUF" Style="{StaticResource AbschnittTitelStil}"/>
                </DockPanel>

                <Border Grid.Row="1" Background="{DynamicResource Zelle}" CornerRadius="10"
                        Margin="0,12,0,0" Padding="16" MinHeight="120">
                    <Grid>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                <RowDefinition/><RowDefinition/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Style="{StaticResource GitterLinie}"/>
                            <Border Grid.Row="1" Style="{StaticResource GitterLinie}"/>
                            <Border Grid.Row="2" Style="{StaticResource GitterLinie}"/>
                            <Border Grid.Row="3" Style="{StaticResource GitterLinie}"/>
                            <Border Grid.Row="4" Style="{StaticResource GitterLinie}"/>
                            <Border Grid.Row="5" Style="{StaticResource GitterLinie}"/>
                        </Grid>

                        <Polyline Stroke="{DynamicResource Akzent}" StrokeThickness="2.5"
                                  StrokeLineJoin="Round" Stretch="Fill"
                                  Points="{Binding TrendPunkte}">
                            <Polyline.Effect>
                                <DropShadowEffect Color="#22D3EE" BlurRadius="8" ShadowDepth="0" Opacity="0.45"/>
                            </Polyline.Effect>
                        </Polyline>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>