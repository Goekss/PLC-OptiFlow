<UserControl x:Class="OptiCHmiApp.Views.Rundanzeige"
             x:Name="Wurzel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="220" Height="120">
    <Viewbox>
        <Grid Width="220" Height="120">
            <Canvas>
                <!-- Grundskala (neutral) -->
                <Path Data="M 10,110 A 100,100 0 0 1 210,110"
                      Stroke="{DynamicResource SchalterAus}" StrokeThickness="10"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>

                <!-- Warnzone 80–90 °C -->
                <Path Data="M 190.9,51.22 A 100,100 0 0 1 205.11,79.1"
                      Stroke="{DynamicResource Warnung}" StrokeThickness="10"/>

                <!-- Kritischzone 90–100 °C -->
                <Path Data="M 205.11,79.1 A 100,100 0 0 1 210,110"
                      Stroke="{DynamicResource Gefahr}" StrokeThickness="10"/>

                <!-- Teilstriche -->
                <Path Stroke="{DynamicResource Trennlinie}" StrokeThickness="1"
                      Data="M10,110 L24,110 M14.89,79.1 L28.22,83.43 M29.1,51.22 L40.41,59.35
                            M51.22,29.1 L59.44,40.41 M79.1,14.89 L83.43,28.22 M110,10 L110,24
                            M140.9,14.89 L136.57,28.22 M168.78,29.1 L160.56,40.41
                            M190.9,51.22 L179.59,59.35 M205.11,79.1 L191.78,83.43 M210,110 L196,110"/>

                <!-- Skalenbeschriftung -->
                <TextBlock Text="0" Canvas.Left="0" Canvas.Top="106" FontSize="9"
                           Foreground="{DynamicResource TextSekundaer}"/>
                <TextBlock Text="100" Canvas.Left="184" Canvas.Top="106" FontSize="9"
                           Foreground="{DynamicResource TextSekundaer}"/>
            </Canvas>

            <!-- Zeiger -->
            <Grid Width="220" Height="120">
                <Grid.RenderTransform>
                    <RotateTransform x:Name="NadelRotation" CenterX="110" CenterY="110" Angle="-90"/>
                </Grid.RenderTransform>
                <Rectangle Width="2" Height="82" Fill="{DynamicResource TextPrimaer}"
                           VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,28,0,0"/>
            </Grid>

            <!-- Nabe -->
            <Ellipse Width="8" Height="8" Fill="{DynamicResource TextPrimaer}"
                     HorizontalAlignment="Left" VerticalAlignment="Top" Margin="106,106,0,0"/>
        </Grid>
    </Viewbox>
</UserControl>
