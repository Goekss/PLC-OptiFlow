<Window x:Class="OptiCHmiApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HMI" Height="460" Width="780" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#FF1F1F23">
            <ListBox ItemsSource="{Binding Menue}"
                     SelectedItem="{Binding AusgewaehlterEintrag, Mode=TwoWay}"
                     Background="Transparent"
                     Foreground="White"
                     BorderThickness="0"
                     Padding="0,12">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Titel}" Padding="16,12" FontSize="14"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <ContentControl Grid.Column="1" Content="{Binding AktuelleSeite}" Margin="24"/>
    </Grid>
</Window>