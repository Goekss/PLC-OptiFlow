<Window x:Class="OptiCHmiApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PLC-OptiFlow" Height="680" Width="1100"
        MinHeight="500" MinWidth="780"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        Background="{DynamicResource Hintergrund}"
        Foreground="{DynamicResource TextPrimaer}">

    <Window.Resources>
        <Style x:Key="MenuItemStil" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextSekundaer}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid Margin="10,2">
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="8"
                                    Padding="18,11">
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Border>
                            <Border x:Name="Bar" Width="3" Height="18" CornerRadius="2"
                                    HorizontalAlignment="Left" Margin="4,0,0,0"
                                    Background="{DynamicResource Akzent}" Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource MenuHover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaer}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource MenuAuswahl}"/>
                                <Setter TargetName="Bar" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{DynamicResource Akzent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Üst bar / Kopfzeile -->
        <Border Grid.Row="0" Background="{DynamicResource Seitenleiste}"
                BorderBrush="{DynamicResource Trennlinie}" BorderThickness="0,0,0,1">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="10" Height="10" CornerRadius="5"
                            Background="{DynamicResource Akzent}" Margin="0,0,10,0">
                        <Border.Effect>
                            <DropShadowEffect Color="#22D3EE" BlurRadius="12" ShadowDepth="0" Opacity="0.8"/>
                        </Border.Effect>
                    </Border>
                    <TextBlock Text="PLC-OptiFlow" FontSize="18" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaer}" VerticalAlignment="Center"/>
                    <Rectangle Width="1" Height="20" Fill="{DynamicResource Trennlinie}" Margin="16,0"/>
                    <TextBlock Text="HMI DASHBOARD" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSekundaer}" VerticalAlignment="Center"/>
                </StackPanel>

                <Button Grid.Column="1" Style="{StaticResource IconButtonStil}"
                        FontFamily="Segoe UI Emoji"
                        Content="{Binding ThemeIcon}"
                        ToolTip="{Binding ThemeTooltip}"
                        Command="{Binding ThemeUmschaltenCommand}"/>
            </Grid>
        </Border>

        <!-- Gövde / Körper -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sol menü / Seitenleiste -->
            <Border Grid.Column="0" Background="{DynamicResource Seitenleiste}"
                    BorderBrush="{DynamicResource Trennlinie}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="MENÜ" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSekundaer}" Opacity="0.7"
                               Margin="28,22,0,8"/>

                    <ListBox Grid.Row="1" ItemsSource="{Binding Menue}"
                             SelectedItem="{Binding AusgewaehlterEintrag, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource MenuItemStil}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Titel}" FontSize="14" FontWeight="Medium"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Grid.Row="2" Text="v1.0" FontSize="11"
                               Foreground="{DynamicResource TextSekundaer}" Opacity="0.5"
                               Margin="28,0,0,18"/>
                </Grid>
            </Border>

            <!-- İçerik / Inhalt -->
            <ContentControl Grid.Column="1" Content="{Binding AktuelleSeite}" Margin="28"/>
        </Grid>
    </Grid>
</Window>