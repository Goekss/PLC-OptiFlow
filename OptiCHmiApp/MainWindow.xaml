<Window x:Class="OptiCHmiApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PLC-OptiFlow" Height="720" Width="1120"
        MinHeight="620" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        Background="{DynamicResource Hintergrund}"
        Foreground="{DynamicResource TextPrimaer}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolZuSichtbarkeit"/>

        <Style x:Key="MenuItemStil" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextSekundaer}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid Margin="8,1">
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="4"
                                    Padding="14,9">
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Border>
                            <Border x:Name="Bar" Width="2" Height="16"
                                    HorizontalAlignment="Left" Margin="2,0,0,0"
                                    Background="{DynamicResource Akzent}" Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource MenuHover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaer}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource MenuAuswahl}"/>
                                <Setter TargetName="Bar" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaer}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StatusPunkt" TargetType="Ellipse">
            <Setter Property="Width" Value="7"/>
            <Setter Property="Height" Value="7"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Fill" Value="{DynamicResource SchalterAus}"/>
        </Style>

        <Style x:Key="StatusText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaer}"/>
        </Style>

        <Style x:Key="StatusTrenner" TargetType="Rectangle">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="Margin" Value="16,0"/>
            <Setter Property="Fill" Value="{DynamicResource Trennlinie}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="34"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Kopfzeile -->
        <Border Grid.Row="0" Background="{DynamicResource Seitenleiste}"
                BorderBrush="{DynamicResource Trennlinie}" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="8" Height="8" CornerRadius="2"
                            Background="{DynamicResource Akzent}" Margin="0,0,10,0"/>
                    <TextBlock Text="PLC-OptiFlow" FontSize="17" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaer}" VerticalAlignment="Center"/>
                    <Rectangle Width="1" Height="18" Fill="{DynamicResource Trennlinie}" Margin="14,0"/>
                    <TextBlock Text="{DynamicResource AppUntertitel}" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSekundaer}" VerticalAlignment="Center"/>
                </StackPanel>

                <Button HorizontalAlignment="Right" Style="{StaticResource IconButtonStil}"
                        FontFamily="Segoe UI Emoji"
                        Content="{Binding ThemeIcon}"
                        ToolTip="{Binding ThemeTooltip}"
                        Command="{Binding ThemeUmschaltenCommand}"/>
            </Grid>
        </Border>

        <!-- Statusleiste: Verbindung, Anlagenzustand, Alarme, letzte Aktualisierung -->
        <Border Grid.Row="1" Background="{DynamicResource Karte}"
                BorderBrush="{DynamicResource Trennlinie}" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse>
                        <Ellipse.Style>
                            <Style TargetType="Ellipse" BasedOn="{StaticResource StatusPunkt}">
                                <Setter Property="Fill" Value="{DynamicResource Gefahr}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status.IstSimulation}" Value="False">
                                        <Setter Property="Fill" Value="{DynamicResource Erfolg}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding Status.VerbindungText}" Style="{StaticResource StatusText}"/>

                    <Rectangle Style="{StaticResource StatusTrenner}"/>

                    <Ellipse>
                        <Ellipse.Style>
                            <Style TargetType="Ellipse" BasedOn="{StaticResource StatusPunkt}">
                                <Setter Property="Fill" Value="{DynamicResource SchalterAus}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status.Notaus}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource Gefahr}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status.Laeuft}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource Erfolg}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding Status.MaschineText}" Style="{StaticResource StatusText}"/>

                    <Rectangle Style="{StaticResource StatusTrenner}"/>

                    <Button Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand"
                            Command="{Binding AlarmeAnzeigenCommand}"
                            ToolTip="{DynamicResource AlarmeAnzeigen}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse>
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse" BasedOn="{StaticResource StatusPunkt}">
                                        <Setter Property="Fill" Value="{DynamicResource SchalterAus}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Status.AlarmeVorhanden}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource Gefahr}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding Status.AlarmText}" Style="{StaticResource StatusText}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11"
                           Foreground="{DynamicResource TextSekundaer}">
                    <Run Text="{DynamicResource LetzteAktualisierung}"/>
                    <Run Text=" "/>
                    <Run Text="{Binding Status.Zeitstempel, Mode=OneWay}"/>
                    <Run Text="  ·  "/>
                    <Run Text="{Binding Status.LetzteAntwortMs, Mode=OneWay}"/>
                    <Run Text=" ms"/>
                </TextBlock>
            </Grid>
        </Border>

        <!-- Alarmbanner -->
        <Border Grid.Row="2" Background="{DynamicResource GefahrFlaeche}"
                Visibility="{Binding Status.AlarmeVorhanden, Converter={StaticResource BoolZuSichtbarkeit}}">
            <Grid Margin="20,6">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⚠" FontSize="12" Foreground="{DynamicResource TextInvertiert}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Status.AlarmText}" Margin="8,0,0,0" FontSize="12"
                               FontWeight="SemiBold" Foreground="{DynamicResource TextInvertiert}"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <Button Content="{DynamicResource AlarmeAnzeigen}" Command="{Binding AlarmeAnzeigenCommand}"
                        HorizontalAlignment="Right" Padding="12,4" FontSize="11"
                        Style="{StaticResource SekundaerButtonStil}"
                        Foreground="{DynamicResource TextInvertiert}"/>
            </Grid>
        </Border>

        <!-- Körper -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Seitenleiste -->
            <Border Grid.Column="0" Background="{DynamicResource Seitenleiste}"
                    BorderBrush="{DynamicResource Trennlinie}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{DynamicResource MenueTitel}" FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSekundaer}"
                               Margin="22,18,0,6"/>

                    <ListBox Grid.Row="1" ItemsSource="{Binding Menue}"
                             SelectedItem="{Binding AusgewaehlterEintrag, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource MenuItemStil}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Titel}" FontSize="13"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Grid.Row="2" Text="v1.1" FontSize="10"
                               Foreground="{DynamicResource TextSekundaer}"
                               Margin="22,0,0,14"/>
                </Grid>
            </Border>

            <!-- Inhalt -->
            <ContentControl Grid.Column="1" Content="{Binding AktuelleSeite}" Margin="20"/>
        </Grid>
    </Grid>
</Window>
